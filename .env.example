# Copiar a .env y completar con tus credenciales. NUNCA commitear .env.

# Credenciales de Colab (SVN) con acceso a nodos/iupa
SVN_URL=https://colab.siu.edu.ar/svn/guarani3/nodos/iupa/gestion/trunk/3.23.0
SVN_3W_URL=https://colab.siu.edu.ar/svn/guarani3/nodos/iupa/3w/trunk/3.23.0
SVN_USER=tu_usuario_colab
SVN_PASSWORD='tu_clave_colab'

# PostgreSQL local del compose (puede ser la misma clave o una distinta)
POSTGRES_DB=guarani3
POSTGRES_USER=tu_usuario_db
POSTGRES_PASSWORD='tu_clave_db'

# Puertos publicados en el host
GESTION_PORT=8090
W3_PORT=8091
DB_PORT_HOST=5434

# Autogestión (3w): alias web e id de unidad académica (ua) de Gestión
AUTOGESTION_ALIAS=/3w
AUTOGESTION_UA=5
AUTOGESTION_EMAIL_AYUDA=soporte@example.edu.ar

# Toba / Guaraní (cambiar TOBA_SALT en producción)
TOBA_PASSWORD=toba
TOBA_SALT='semilla_aleatoria_larga'
