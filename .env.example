# Copiar a .env y completar con tus credenciales. NUNCA commitear .env.

# Credenciales de Colab (SVN) con acceso a nodos/iupa
SVN_URL=https://colab.siu.edu.ar/svn/guarani3/nodos/iupa/gestion/trunk/3.23.0
SVN_3W_URL=https://colab.siu.edu.ar/svn/guarani3/nodos/iupa/3w/trunk/3.23.0
SVN_USER=tu_usuario_colab
SVN_PASSWORD='tu_clave_colab'

# PostgreSQL local del compose (puede ser la misma clave o una distinta)
POSTGRES_DB=guarani3
POSTGRES_USER=tu_usuario_db
POSTGRES_PASSWORD='tu_clave_db'

# Puertos publicados en el host
GESTION_PORT=8090
W3_PORT=8091
DB_PORT_HOST=5434

# Autogestión (3w): alias web e id de unidad académica (ua) de Gestión
AUTOGESTION_ALIAS=/3w
AUTOGESTION_UA=5
AUTOGESTION_EMAIL_AYUDA=soporte@example.edu.ar

# Preinscripción (base propia "preinscripcion" en el mismo PostgreSQL)
PREINSCRIPCION_PORT=8092
PREINSCRIPCION_PTO=iupa
PREINSCRIPCION_ADMIN_USER=admin
PREINSCRIPCION_ADMIN_PASSWORD=cambiar-clave-admin

# Kolla 4.10.3: colocar instalador_kolla_4.10.3.rar en la raíz y correr scripts/05-extraer-kolla.sh
KOLLA_PORT=8093
KOLLA_ALIAS=/kolla
KOLLA_PASSWORD=toba123*-a
# Usuario de BD dedicado (clave simple: Toba arma comandos shell con la clave)
KOLLA_DB_USER=kolla
KOLLA_DB_PASSWORD=kolla123

# Tehuelche 4.5.2: poner instalador_tehuelche_4.5.2.rar en la raíz y correr scripts/06-extraer-tehuelche.sh
TEHUELCHE_PORT=8094
TEHUELCHE_ALIAS=/tehuelche
TEHUELCHE_PASSWORD=toba123*-a
TEHUELCHE_DB_USER=tehuelche
TEHUELCHE_DB_PASSWORD=tehuelche123

# Toba / Guaraní (cambiar TOBA_SALT en producción)
TOBA_PASSWORD=toba
TOBA_SALT='semilla_aleatoria_larga'
